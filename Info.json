{
  "name": "Hoshitan",
  "identifier": "io.github.akihazhang.hoshitan",
  "version": "0.1.0-dev.12",
  "author": {
    "name": "AkihaZhang"
  },
  "description": "Subtitle dictionary lookup and Anki card creation for IINA.",
  "entry": "main.js",
  "globalEntry": "global.js",
  "preferencesPage": "preferences.html",
  "helpPage": "README.md",
  "ghRepo": "AkihaZhang/hoshitan",
  "ghVersion": 2,
  "preferenceDefaults": {
    "enabledByDefault": true,
    "hideNativeSubtitles": true,
    "audioAutoPlay": false,
    "audioProbeOnPopup": false,
    "audioSourcesJson": "[{\"name\":\"Hoshi Reader\",\"url\":\"https://hoshi-reader.manhhaoo-do.workers.dev/?term={term}&reading={reading}\"}]",
    "lookupLanguage": "ja",
    "fontScale": 0.65,
    "nativeSubtitleScale": 0.65,
    "popupScale": 0.92,
    "popupMaxWidth": 440,
    "popupMaxHeight": 520,
    "popupTheme": "inherit",
    "maxEntries": 3,
    "maxGlossesPerEntry": 4,
    "scanLength": 24,
    "hoverRequestTimeoutMs": 15000,
    "backendTimeoutMs": 30000,
    "importTimeoutMs": 1800000,
    "lowRamImport": true,
    "uiLanguage": "auto",
    "subtitlePollMs": 120,
    "popupMaxHeightVh": 34,
    "popupSubtitleGapPx": 34,
    "popupTopMarginPx": 56,
    "pauseWhilePopupVisible": true,
    "lookupTimeoutMs": 9000,
    "etymologyCollapseDefault": "collapsed",
    "wiktionaryEtymologyCollapseOverride": "collapsed",
    "customPopupCss": "",
    "debugLogEnabled": true,
    "debugLogVerbose": false,
    "directIpcPollMs": 16,
    "workerIdleSleepMs": 30,
    "ankiConnectUrl": "http://127.0.0.1:8765",
    "ankiApiKey": "",
    "ankiDeckName": "Default",
    "ankiModelName": "Basic",
    "ankiFieldMappingsJson": "{}",
    "ankiFieldSentence": "Front",
    "ankiFieldExpression": "",
    "ankiFieldReading": "",
    "ankiFieldDefinition": "Back",
    "ankiFieldImage": "",
    "ankiFieldAudio": "",
    "ankiFieldSource": "",
    "ankiTags": "hoshitan",
    "ankiAllowDuplicate": false,
    "ankiIncludeScreenshot": true,
    "ankiIncludeAudio": true,
    "ankiAudioPaddingMs": 120,
    "ankiFfmpegPath": "/opt/homebrew/bin/ffmpeg",
    "localAudioEnabled": false,
    "localAudioDatabasePath": ""
  },
  "permissions": [
    "video-overlay",
    "network-request",
    "file-system",
    "show-osd",
    "show-alert"
  ],
  "allowedDomains": [
    "*"
  ]
}
